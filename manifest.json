{
  "manifest_version": 3,
  "name": "AssetFlow - 视觉资产复用工作台 V1.9.13",
  "description": "把参考图整理成可追溯的复用方案，支持视觉分析、提示词编译、AI 生图、异步任务恢复、本地图库与 Eagle 收集。",
  "version": "1.9.13",
  "action": {
    "default_title": "AssetFlow V1.9.13",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "alarms",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
